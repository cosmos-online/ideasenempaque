# =============================================
# .htaccess — Ideas Empaque — Cosmos Online
# =============================================

# Ocultar archivos sensibles
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>
<Files "CLAUDE.md">
    Order allow,deny
    Deny from all
</Files>

# Deshabilitar listado de directorios
Options -Indexes

# Headers de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# URLs limpias y enrutamiento
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS (descomentar cuando SSL esté activo)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Páginas estáticas (rutas exactas — nunca capturan /admin/)
    RewriteRule ^quienes-somos/?$  quienes-somos.php  [L]
    RewriteRule ^nosotros/?$       quienes-somos.php  [L]
    RewriteRule ^productos/?$      productos.php       [L]
    RewriteRule ^contacto/?$       contacto.php        [L]
    RewriteRule ^cotizador/?$      cotizador.php       [L]
    RewriteRule ^gracias/?$        gracias.php         [L]

    # Slug de producto — solo si no es archivo real, directorio real, ni ruta /admin/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^(/[^/]+)?/admin(/|$)
    RewriteRule ^([a-z0-9\-]+)/?$  producto.php?slug=$1  [L,QSA]
</IfModule>

# PHP 7.4 (descomentar si el servidor requiere especificarlo)
# AddHandler application/x-httpd-php74 .php
